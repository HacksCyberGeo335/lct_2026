# Copy these values to the root .env when external servers are ready.
# These example host ports are distinct; adjust to the real deployment.
TRITON_HTTP_URL=http://host.docker.internal:8000
TRITON_MODEL_NAME=detector
TRITON_MODEL_VERSION=1
TRITON_INPUT_NAME=images
TRITON_OUTPUT_NAME=output0
YOLO_IMAGE_SIZE=768
YOLO_CONFIDENCE=0.25
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=Qwen/Qwen3-VL-2B-Instruct
VLLM_API_KEY=
TRITON_API_KEY=
FRAME_INTERVAL_SECONDS=1
MAX_FRAMES=300
MAX_DOWNLOAD_BYTES=2147483648
VLM_MAX_EDGE=1280
VLM_MAX_TOKENS=1024
INFERENCE_TIMEOUT_SECONDS=120
JOB_LEASE_SECONDS=180
POLL_SECONDS=2
