COMPOSE_PROJECT_NAME=lct_2026
APP_ENV=local

POSTGRES_IMAGE=prom_app_postgres:local
POSTGRES_CONTAINER_NAME=prom_app_postgres
POSTGRES_HOST_PORT=5432
POSTGRES_DB=prom_app
POSTGRES_USER=prom_app
POSTGRES_PASSWORD=prom_app_password
DATABASE_URL=postgres://prom_app:prom_app_password@postgres:5432/prom_app?sslmode=disable

REDIS_IMAGE=prom_app_redis:local
REDIS_CONTAINER_NAME=prom_app_redis
REDIS_HOST_PORT=6379

MINIO_BASE_IMAGE=minio/minio:latest
MINIO_IMAGE=prom_app_minio:local
MINIO_MC_IMAGE=minio/mc:latest
MINIO_CONTAINER_NAME=prom_app_s3_storage
MINIO_INIT_CONTAINER_NAME=prom_app_s3_init
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=prom_app
MINIO_ROOT_PASSWORD=prom_app_password
MINIO_INTERNAL_ENDPOINT=http://s3-storage:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ORIGINALS_BUCKET=video-originals-prom
MINIO_DERIVED_BUCKET=video-derived-prod
MINIO_DETECTIONS_BUCKET=video-detections-prod

UPLOAD_SERVICE_IMAGE=prom_app_upload_service:local
UPLOAD_SERVICE_CONTAINER_NAME=prom_app_upload_service
UPLOAD_SERVICE_HOST_PORT=8081
UPLOAD_SERVICE_ADDRESS=:8081
UPLOAD_SERVICE_URL=http://upload_service:8081

API_GATEWAY_IMAGE=prom_app_api_gateway:local
API_GATEWAY_CONTAINER_NAME=prom_app_api_gateway
API_GATEWAY_HOST_PORT=8080
API_GATEWAY_ADDRESS=:8080

FRONTEND_IMAGE=lct_2026-frontend:latest
FRONTEND_CONTAINER_NAME=prom_app_frontend
FRONTEND_HOST_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

LOKI_IMAGE=grafana/loki:3.2.1
LOKI_CONTAINER_NAME=prom_app_loki
LOKI_HOST_PORT=3100

ALLOY_IMAGE=grafana/alloy:v1.5.1
ALLOY_CONTAINER_NAME=prom_app_alloy
ALLOY_HOST_PORT=12345

GRAFANA_IMAGE=grafana/grafana:11.2.2
GRAFANA_CONTAINER_NAME=prom_app_grafana
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_DEFAULT_THEME=light
GRAFANA_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/prom_app_http_logs.json
